PYTHONDONTWRITEBYTECODE=1
APP_NAME="PTC1 FastAPI Server"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["*"]
# Chuỗi kết nối PostgreSQL 14 (cổng 5432)
DATABASE_URL="postgresql+psycopg://postgres:2005@localhost:5432/ptc1_db"
TEST_DATABASE_URL="postgresql+psycopg://postgres:2005@localhost:5432/ptc1_test_db"
DB_ECHO=false

# Cấu hình OpenStreetMap (Nominatim)
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="PTC1-FastAPI-Server/0.1.0 (contact@example.com)"
NOMINATIM_TIMEOUT_SECONDS=8.0
