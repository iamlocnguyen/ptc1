PYTHONDONTWRITEBYTECODE=1
APP_NAME="PTC1 FastAPI Server"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["*"]
# Chuỗi kết nối PostgreSQL 14 (cổng 5433)
DATABASE_URL="postgresql+psycopg://postgres:2005@localhost:5433/ptc1_db"
# Hoặc fallback về SQLite:
# DATABASE_URL="sqlite:///./app.db"
DB_ECHO=false
